{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Django Server",
            "type": "shell",
            "command": "python manage.py runserver 127.0.0.1:8000",
            "options": {
                "cwd": "${workspaceFolder}/django_backend"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Run KTU Test Suite",
            "type": "shell",
            "command": "python test_all_features.py",
            "options": {
                "cwd": "${workspaceFolder}/django_backend"
            },
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Django: Makemigrations",
            "type": "shell",
            "command": "python manage.py makemigrations",
            "options": {
                "cwd": "${workspaceFolder}/django_backend"
            },
            "problemMatcher": []
        },
        {
            "label": "Django: Migrate",
            "type": "shell",
            "command": "python manage.py migrate",
            "options": {
                "cwd": "${workspaceFolder}/django_backend"
            },
            "problemMatcher": []
        }
    ]
}
